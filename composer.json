{
    "name": "aporat/laravel-rate-limiter",
    "description": "Redis-backed, multi-window rate limiting middleware and limiter for Laravel",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/aporat/laravel-rate-limiter",
    "keywords": [
        "laravel",
        "rate-limiter",
        "rate-limiting",
        "middleware",
        "throttle",
        "redis"
    ],
    "authors": [
        {
            "name": "Adar Porat",
            "email": "aporat28@gmail.com",
            "homepage": "https://github.com/aporat",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/redis": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/http-foundation": "^7.2 || ^8.0",
        "symfony/http-kernel": "^7.2 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "predis/predis": "^2.3 || ^3.0"
    },
    "suggest": {
        "ext-redis": "Required to use the phpredis client (Laravel's default).",
        "predis/predis": "Required to use the predis client."
    },
    "autoload": {
        "psr-4": {
            "Aporat\\RateLimiter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aporat\\RateLimiter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aporat\\RateLimiter\\RateLimiterServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-ci": "phpunit --colors=always --coverage-text --coverage-clover coverage.xml --log-junit junit.xml",
        "check": "pint --test",
        "analyze": "phpstan analyse --memory-limit=-1",
        "qa": [
            "@check",
            "@analyze",
            "@test"
        ]
    },
    "support": {
        "issues": "https://github.com/aporat/laravel-rate-limiter/issues",
        "source": "https://github.com/aporat/laravel-rate-limiter"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
